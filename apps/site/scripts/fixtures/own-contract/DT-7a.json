{
  "color": {
    "$type": "color",
    "a": {
      "$value": "{color.b}"
    },
    "b": {
      "$value": "{color.c}"
    },
    "c": {
      "$value": "{color.a}"
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  }
}