{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Fixture DTCG Full",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.3608,
          1.0
        ],
        "hex": "#1a5cff"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "hsl",
        "components": [
          214,
          17.24,
          8.04
        ]
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.66,
          0.18,
          250
        ]
      }
    },
    "deep": {
      "$value": {
        "colorSpace": "lab",
        "components": [
          30,
          10,
          -50
        ],
        "hex": "#3b4887"
      }
    },
    "deep-nohex": {
      "$value": {
        "colorSpace": "lab",
        "components": [
          30,
          10,
          -50
        ]
      }
    },
    "wide": {
      "$value": {
        "colorSpace": "rec2020",
        "components": [
          0.5,
          0.2,
          0.1
        ],
        "hex": "#a0522d"
      }
    },
    "far": {
      "$value": {
        "colorSpace": "prophoto-rgb",
        "components": [
          0.5,
          0.2,
          0.1
        ]
      }
    },
    "focus": {
      "$value": "{color.primary}"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    }
  },
  "control": {
    "$type": "dimension",
    "$extensions": {
      "org.designesy": {
        "role": "size",
        "interactive": true
      }
    },
    "min": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    }
  },
  "corner": {
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$extensions": {
        "org.designesy": {
          "role": "radius",
          "cssVar": "--pill"
        }
      }
    }
  },
  "misc": {
    "$type": "dimension",
    "odd": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Manrope",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": "IBM Plex Mono"
    }
  },
  "duration": {
    "$type": "duration",
    "quick": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 0.4,
        "unit": "s"
      }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "code": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "lineHeight": 1.4
      },
      "$extensions": {
        "org.designesy": {
          "features": [
            "tnum"
          ]
        }
      }
    }
  },
  "motion": {
    "$type": "transition",
    "fade": {
      "$value": {
        "duration": "{duration.quick}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{ease.out}"
      }
    }
  },
  "border": {
    "$type": "border",
    "focus": {
      "$value": {
        "color": "{color.primary}",
        "width": {
          "value": 2,
          "unit": "px"
        },
        "style": "solid"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.2
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "$extensions": {
    "org.designesy": {
      "pairs": [
        {
          "text": "{color.on-primary}",
          "background": "{color.primary}",
          "role": "primary-action"
        },
        {
          "text": "{color.ink}",
          "background": "{color.on-primary}"
        }
      ],
      "tokenMap": {
        "color.primary": "--brand"
      }
    }
  }
}