# Environment variables the site reads. Names only: never commit a value.
# Copy this file to .env.local and fill in only what you need. Every variable
# is optional for local development: without it, the feature it powers is off
# or fails closed.

# --- Rate limiting and usage counts (Upstash Redis REST API) ---
# REST URL of the Upstash Redis database. Without it, rate limiting and usage counts are unavailable.
UPSTASH_REDIS_REST_URL=
# REST token for that database.
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashing caller IPs in usage counts. Falls back to CRON_SECRET.
USAGE_SALT=

# --- Admin routes ---
# Bearer secret for /api/admin/*. Without it they return 401.
CRON_SECRET=

# --- Email ---
# Resend API key for monitor drift alerts and waitlist notices. Without it, no email is sent.
RESEND_API_KEY=
# Monitor drift-alert email: off unless exactly "true" (the key is needed too).
# Nothing confirms that a recipient asked for the mail, so leave it unset.
MONITOR_EMAIL_ENABLED=
# Address that receives waitlist notices. Has a built-in default.
WAITLIST_NOTIFY_TO=
# Sender for waitlist notices. Has a built-in default.
WAITLIST_FROM_EMAIL=
# Optional HTTPS webhook that also receives waitlist sign-ups.
WAITLIST_WEBHOOK_URL=

# --- Full browser audit (/api/score/audit) ---
# Set to 1 or true to enable the browser audit. Off when empty.
ENABLE_BROWSER_AUDIT=
# WebSocket URL of a remote Chrome (CDP) to attach to. When empty, the audit launches Chromium in the function.
CDP_ENDPOINT=
# JSON object of headers for CDP_ENDPOINT, if the browser service needs auth.
CDP_HEADERS_JSON=
# Google PageSpeed Insights API key for Core Web Vitals. Uses the public quota when empty.
PSI_API_KEY=

# --- Local scripts in apps/site/scripts ---
# Comma-separated routes for scripts/a11y-sweep.js (same as --routes).
A11Y_ROUTES=
# Comma-separated routes for scripts/visual-floor.js.
FLOOR_ROUTES=
# Host of a local Chrome debugging port for scripts/blind-comparison.mjs. Defaults to 127.0.0.1.
CDP_HOST=
# Port of that Chrome debugging port. Defaults to 9222.
CDP_PORT=

# --- Set by the platform. Listed for completeness; do not set these yourself ---
# Set by Node.js and Next.js.
# NODE_ENV=
# Set by the browser audit at run time, for the Chromium libraries.
# LD_LIBRARY_PATH=
# Set by Vercel on its builds and deployments.
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_REGION=
# VERCEL_DEPLOYMENT_ID=
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_REF=
# VERCEL_GIT_COMMIT_MESSAGE=
