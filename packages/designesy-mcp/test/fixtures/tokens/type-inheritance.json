{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.96, 0.97], "alpha": 1 } },
    "surface": {
      "$root": { "$value": { "colorSpace": "srgb", "components": [0.02, 0.02, 0.03], "alpha": 1 } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [0.05, 0.05, 0.07], "alpha": 1 } }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 1, "unit": "rem" } }
  },
  "button": {
    "$extends": "{color}",
    "border": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1 } }
  },
  "card": {
    "$extends": "#/space",
    "gap": { "$value": { "value": 12, "unit": "px" } }
  },
  "semantic": {
    "text": { "$value": "{color.ink}" },
    "gutter": { "$value": "{space.md}" }
  }
}
