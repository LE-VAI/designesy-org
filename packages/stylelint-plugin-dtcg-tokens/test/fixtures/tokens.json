{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#3b82f6",
      "$description": "Brand primary blue"
    },
    "secondary": {
      "$type": "color",
      "$value": "#10b981",
      "$description": "Brand secondary green"
    },
    "danger": {
      "$type": "color",
      "$value": "#ef4444",
      "$description": "Error/danger red"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Default surface background"
    },
    "text": {
      "$type": "color",
      "$value": "#1a1a1a",
      "$description": "Primary text color"
    }
  },
  "space": {
    "xs": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Extra small spacing"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Small spacing"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Medium spacing"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Large spacing"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Extra large spacing"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Small border radius"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Medium border radius"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Large border radius"
    }
  },
  "font": {
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Small font size"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Medium (body) font size"
      },
      "lg": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Large font size"
      }
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "150ms",
      "$description": "Fast transition duration"
    },
    "normal": {
      "$type": "duration",
      "$value": "250ms",
      "$description": "Normal transition duration"
    }
  }
}