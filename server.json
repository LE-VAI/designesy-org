{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LE-VAI/designesy-org",
  "title": "Designesy",
  "description": "Design quality gate for AI-generated UI: score any URL on 45 deterministic checks, A–F grade.",
  "repository": {
    "url": "https://github.com/LE-VAI/designesy-org",
    "source": "github"
  },
  "version": "1.13.9",
  "license": "MIT",
  "websiteUrl": "https://www.designesy.org",
  "icons": [
    {
      "src": "https://www.designesy.org/brand/designesy-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://www.designesy.org/brand/designesy-icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.designesy.org/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "designesy-mcp",
      "version": "1.13.9",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "install_local": "pip install designesy-mcp && designesy-mcp",
      "tool": "mcp-publisher",
      "tools_exposed": [
        "designesy_catalog",
        "designesy_contract",
        "designesy_design_review",
        "designesy_skill_md",
        "designesy_agent_json",
        "designesy_llms_txt",
        "designesy_llms_full_txt",
        "designesy_score",
        "designesy_tokens_score",
        "designesy_a11y_score",
        "designesy_motion_score",
        "designesy_drift_score",
        "designesy_readiness_score",
        "designesy_guardrails",
        "designesy_monitor_score",
        "designesy_compare",
        "designesy_report"
      ],
      "transport_note": "Two paths: (1) PyPI package — pip install designesy-mcp (or uvx designesy-mcp), run as a stdio MCP server locally. (2) Remote — https://www.designesy.org/api/mcp, stateless Streamable HTTP, no auth. Server Card: https://www.designesy.org/api/mcp/server-card. This io.github name is the one canonical listing; it republishes on every release tag via GitHub OIDC.",
      "auth": "github-oidc"
    }
  }
}
