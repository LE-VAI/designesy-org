{
  "name": "designesy-score",
  "version": "1.0.5",
  "description": "Design quality gate for AI-generated UI: score any URL on 45 deterministic checks, A–F grade. Runs locally with no Designesy server; browser checks return MANUAL.",
  "license": "MIT",
  "author": "Designesy",
  "homepage": "https://www.designesy.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LE-VAI/designesy-org.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/LE-VAI/designesy-org/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "design-contract",
    "design-verification",
    "accessibility",
    "wcag",
    "core-web-vitals",
    "ci",
    "quality-gate",
    "designesy"
  ],
  "type": "module",
  "bin": {
    "designesy-score": "cli/designesy-score.mjs"
  },
  "files": [
    "cli/designesy-score.mjs",
    "cli/README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "packages/score/dist/engine.js",
    "packages/score/dist/engine.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "scripts": {
    "dev": "cd apps/site && npm run dev",
    "build": "npm --prefix apps/site run build && npm --prefix packages/score run build",
    "build:score": "cd packages/score && npx tsc -p tsconfig.json",
    "lint": "cd apps/site && npm run lint",
    "score": "node cli/designesy-score.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "check-retired-literals": "node apps/site/scripts/check-retired-literals.js && node scripts/check-retired-literals-packages.js"
  }
}