{
  "name": "designesy-score",
  "version": "1.0.0",
  "description": "Score any URL against the Designesy 40-check design-contract engine — runs locally, no server required. Zero dependencies.",
  "license": "MIT",
  "author": "Designesy",
  "homepage": "https://www.designesy.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LE-VAI/designesy-org.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/LE-VAI/designesy-org/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "design-contract",
    "design-verification",
    "accessibility",
    "wcag",
    "core-web-vitals",
    "ci",
    "quality-gate",
    "designesy"
  ],
  "type": "module",
  "bin": {
    "designesy-score": "cli/designesy-score.mjs"
  },
  "files": [
    "cli/designesy-score.mjs",
    "cli/README.md",
    "CHANGELOG.md",
    "packages/score/dist/engine.js",
    "packages/score/dist/engine.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "private": false,
  "scripts": {
    "dev": "cd apps/site && npm run dev",
    "build": "cd apps/site && npm run build && cd packages/score && npx tsc -p tsconfig.json",
    "build:score": "cd packages/score && npx tsc -p tsconfig.json",
    "lint": "cd apps/site && npm run lint",
    "score": "node cli/designesy-score.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs"
  }
}